---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Me";

const identity = {
  firstName: "Paul",
  country: "México",
  occupation: "estudiante",
  hobbies: ["guitarra", "emprendimiento", "GYM"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Documentación"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "maroon";
const fontWeight = "bold";
const textCase = "uppercase";
---

  <style define:vars={{skillColor, fontWeight, textCase}}>
    h1 {
      color: maroon;
      font-size: 4rem;
    }
  .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }
</style>

<BaseLayout pageTitle={pageTitle}>
    <h2>... ¡y mi nuevo sitio de Astro!</h2>

    <p>Estoy siguiendo el tutorial introductorio de Astro. Esta es la segunda página de mi sitio web y es la primera que he creado por mi cuenta.</p>

    <p>Este sitio se actualizará a medida que complete más partes del tutorial, así que vuelve pronto para ver cómo avanza mi recorrido.</p>

    <p>Estos son algunos datos sobre mí:</p>

    <ul>
        <li>Me llamo {identity.firstName}.</li>
        <li>Vivo en {identity.country} y soy {identity.occupation}.</li>
        {identity.hobbies.length >= 2 &&
        <li>Dos de mis aficiones son: {identity.hobbies[0]} y {identity.hobbies[1]}, pero también me gusta el {identity.hobbies[2]}.</li>
        }
    </ul>

      <p>Mis habilidades son:</p>

  <ul>
    {skills.map((skill) => <li class="skill"> {skill}</li>)}

    {happy && <p>¡Me alegra estar aprendiendo Astro!</p>}

    {finished && <p>¡He terminado este tutorial!</p>}

    {goal === 3 ? <p>Mi objetivo es terminarlo en 3 días.</p> : <p>Mi objetivo no es terminarlo en 3 días.</p>}

  </ul>

</BaseLayout>
